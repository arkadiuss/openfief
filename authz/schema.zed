// OpenFief's authorization model (D-163, D-164), as a SpiceDB schema.
// `task authz:validate` checks it against the relationships and assertions
// in validation.yaml; CI runs it as part of `task check`.
//
// Until SpiceDB answers the core's authorization interface (the --authz flag,
// D-164), identity.MayAct gives the same answers as this schema with the
// relationships below: the owner may act on every account, and every other
// holder of read access (D-137) views every account, each through a household
// grant (D-209). The contract test (internal/identity/spicedb) checks it.

// person is someone with their own passkey: the owner, and from the second
// alpha the viewers the owner enrolls (D-65).
definition person {}

// script_token is one of the owner's script tokens (D-27).
definition script_token {}

// view_plugin is a view plugin, by its plugin identity (D-27).
definition view_plugin {}

// demo_session is a read-scoped session from the demo authenticator.
definition demo_session {}

// sleeve is one of the household's sleeves (D-71). A grant of a sleeve
// covers every account in it, those placed there later too (D-209).
definition sleeve {
	// viewer is a person, script token or view plugin granted the sleeve to
	// view (D-209). A grant only ever lets its holder view.
	relation viewer: person | script_token | view_plugin

	// view is viewing every account in the sleeve.
	permission view = viewer
}

// household is the one household an installation serves, with no tenants
// (D-65).
definition household {
	// owner holds every account and alone changes anything.
	relation owner: person

	// reader is the household grant (D-209): the holder views every
	// account of the household, present and future, and changes none. The
	// owner gives it to a person, a script token or a view plugin, and every
	// demo session has it (D-137, D-68).
	relation reader: person | script_token | view_plugin | demo_session:*

	// change_accounts is changing every account of the household.
	permission change_accounts = owner

	// view_accounts is viewing every account of the household.
	permission view_accounts = change_accounts + reader
}

// account is one of the household's accounts.
definition account {
	relation household: household

	// sleeve is the sleeve the account is in, when it is in one (D-71).
	relation sleeve: sleeve

	// viewer is a person, script token or view plugin granted this account
	// alone to view (D-65, D-164, D-209).
	relation viewer: person | script_token | view_plugin

	// change is changing the account or anything recorded in it.
	permission change = household->change_accounts

	// view is reading the account and everything recorded in it: the
	// owner's, a grant of the account, of its sleeve or of the household.
	permission view = change + viewer + sleeve->view + household->view_accounts
}
