{
  "name": "openfief-devtools",
  "private": true,
  "description": "Developer tooling only (kibi requirements layer, docs diagram rendering). Not part of the OpenFief product.",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "patch-package --error-on-fail --error-on-warn"
  },
  "devDependencies": {
    "kibi-cli": "2.36.0",
    "kibi-core": "0.26.1",
    "kibi-mcp": "3.21.0",
    "kibi-plugin-treesitter": "2.0.2",
    "mermaid": "12.2.0",
    "patch-package": "8.0.1",
    "playwright-core": "1.63.0"
  },
  "kibi": {
    "plugins": [
      {
        "package": "kibi-plugin-treesitter",
        "capabilities": {
          "kibi.symbol-extractor.v2": {
            "mode": "augment"
          }
        }
      }
    ]
  }
}
