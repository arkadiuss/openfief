+%% kb_dedupe_graph_triples(+Graph)
+% Local patch (OpenFief, patches/kibi-core+0.26.1.patch): kibi 2.36's sync
+% can publish a store holding exact duplicate triples (whole entities and
+% relationships stored twice), and every kb_entity/3 and kb_relationship/3
+% lookup then answers twice; requirement proofs multiply those answers until
+% a coverage query passes the engine's 120 s limit. Keep one copy of each
+% triple. The type-triple count is the cheap check; the full pass runs only
+% when it finds duplicates. The removal is journaled like any other write, so
+% the store on disk is repaired too. The pass is loud: it prints the counts on
+% stderr and records them in kb_dedupe_report/2, which the patched CLI prints
+% (patches/kibi-cli+2.36.0.patch), so the publish defect stays visible.
+kb_dedupe_graph_triples(Graph) :-
+    retractall(kb_dedupe_report(_, _)),
+    aggregate_all(count, rdf(_, kb:type, _, Graph), TypeCount),
+    findall(S-O, rdf(S, kb:type, O, Graph), TypePairs),
+    sort(TypePairs, DistinctTypePairs),
+    length(DistinctTypePairs, DistinctTypeCount),
+    (   TypeCount =:= DistinctTypeCount
+    ->  true
+    ;   findall(t(S, P, O), rdf(S, P, O, Graph), Triples),
+        msort(Triples, Sorted),
+        clumped(Sorted, Counted),
+        findall(t(S, P, O)-N, ( member(t(S, P, O)-N, Counted), N > 1 ), Duplicated),
+        aggregate_all(sum(N - 1), member(_-N, Duplicated), RemovedTriples),
+        rdf_global_id(kb:type, TypePredicate),
+        aggregate_all(count, member(t(_, TypePredicate, _)-_, Duplicated), TwiceEntities),
+        rdf_transaction(
+            forall(member(t(S, P, O)-_, Duplicated),
+                   ( rdf_retractall(S, P, O, Graph), rdf_assert(S, P, O, Graph) ))),
+        kb_mark_dirty,
+        assertz(kb_dedupe_report(RemovedTriples, TwiceEntities)),
+        format(user_error,
+               "kibi (local patch): removed ~d duplicate triples (~d entities stored twice) from the published store - kibi's publish defect, see docs/dev/kibi.md~n",
+               [RemovedTriples, TwiceEntities])
+    ).
+
