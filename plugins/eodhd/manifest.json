{
  "capabilities": ["connector"],
  "egress": ["eodhd.com"],
  "secrets": [{"name": "eodhd-credentials", "mountPath": "/etc/openfief/eodhd"}],
  "configSchema": {
    "type": "object",
    "properties": {
      "start": {"type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}"},
      "instruments": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "isin": {"type": "string", "pattern": "^[A-Z]{2}[A-Z0-9]{9}[0-9]$"},
            "exchange": {"enum": ["WAR", "LSE", "XETRA", "PA", "AS", "BR", "LS", "IR", "MI", "OL"]},
            "symbol": {"type": "string", "minLength": 1}
          },
          "required": ["isin"],
          "additionalProperties": false
        }
      },
      "indices": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "ticker": {"type": "string", "pattern": "^[A-Za-z0-9_-]+[.]INDX$"}
          },
          "required": ["name", "ticker"],
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  }
}
