{
  "capabilities": ["connector"],
  "institutions": ["eodhd"],
  "indexLevels": true,
  "egress": ["eodhd.com"],
  "egressFromConfig": ["baseUrl"],
  "secrets": [{"role": "api-token", "mountPath": "/etc/openfief/eodhd"}, {"role": "ca-bundle", "mountPath": "/etc/openfief/ca-bundle", "optional": true}],
  "marketData": true,
  "configSchema": {
    "type": "object",
    "properties": {
      "start": {"type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}"},
      "baseUrl": {"type": "string", "maxLength": 2048, "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[^?#\\s]*)?$",
        "default": "https://eodhd.com",
        "description": "The EODHD API, or a mirror of it: an https URL; the install shows its host and the grant approves it"},
      "instruments": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "isin": {"type": "string", "pattern": "^[A-Z]{2}[A-Z0-9]{9}[0-9]$"},
            "exchange": {"enum": ["WAR", "LSE", "XETRA", "PA", "AS", "BR", "LS", "IR", "MI", "OL"]},
            "symbol": {"type": "string", "minLength": 1}
          },
          "required": ["isin"],
          "additionalProperties": false
        }
      },
      "indices": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "ticker": {"type": "string", "pattern": "^[A-Za-z0-9_-]+[.]INDX$"}
          },
          "required": ["name", "ticker"],
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  }
}
