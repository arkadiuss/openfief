    {
      "id": 7,
      "type": "timeseries",
      "title": "Turnstile time to token, p50 and p95",
      "description": "openfief.ui.turnstile.token_seconds: time from a Turnstile check starting to its token, quantiles of the histogram.",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(openfief_ui_turnstile_token_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(openfief_ui_turnstile_token_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
