{
  "uid": "openfief-core-error-logs",
  "title": "Core error logs above threshold",
  "orgID": 1,
  "folderUID": "openfief-demo",
  "ruleGroup": "openfief-demo",
  "condition": "C",
  "noDataState": "OK",
  "execErrState": "KeepLast",
  "for": "0s",
  "isPaused": false,
  "annotations": {
    "summary": "The demo's core logged more than 10 errors in 15 minutes",
    "description": "Records of service_name core at level error or above, counted over 15 minutes. The OpenFief demo dashboard's error log panel lists them."
  },
  "labels": {
    "app": "openfief",
    "env": "demo",
    "severity": "warning"
  },
  "data": [
    {
      "refId": "A",
      "relativeTimeRange": {
        "from": 900,
        "to": 0
      },
      "datasourceUid": "grafanacloud-logs",
      "model": {
        "refId": "A",
        "datasource": {
          "type": "loki",
          "uid": "grafanacloud-logs"
        },
        "expr": "sum(count_over_time({service_name=\"core\"} | detected_level=~\"(?i)error|fatal|critical\" [15m]))",
        "editorMode": "code",
        "intervalMs": 1000,
        "maxDataPoints": 43200,
        "queryType": "instant"
      }
    },
    {
      "refId": "B",
      "datasourceUid": "__expr__",
      "model": {
        "refId": "B",
        "type": "reduce",
        "expression": "A",
        "reducer": "last",
        "datasource": {
          "type": "__expr__",
          "uid": "__expr__"
        },
        "intervalMs": 1000,
        "maxDataPoints": 43200
      }
    },
    {
      "refId": "C",
      "datasourceUid": "__expr__",
      "model": {
        "refId": "C",
        "type": "threshold",
        "expression": "B",
        "datasource": {
          "type": "__expr__",
          "uid": "__expr__"
        },
        "intervalMs": 1000,
        "maxDataPoints": 43200,
        "conditions": [
          {
            "evaluator": {
              "type": "gt",
              "params": [
                10
              ]
            },
            "operator": {
              "type": "and"
            },
            "query": {
              "params": [
                "C"
              ]
            },
            "reducer": {
              "type": "last",
              "params": []
            },
            "type": "query"
          }
        ]
      }
    }
  ]
}
