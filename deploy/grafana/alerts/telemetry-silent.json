{
  "uid": "openfief-telemetry-silent",
  "title": "Demo telemetry is silent",
  "orgID": 1,
  "folderUID": "openfief-demo",
  "ruleGroup": "openfief-demo",
  "condition": "C",
  "noDataState": "Alerting",
  "execErrState": "KeepLast",
  "for": "0s",
  "isPaused": false,
  "annotations": {
    "summary": "No demo logs reached Grafana for 30 minutes",
    "description": "No log record from any pod of the namespace openfief in 30 minutes (Postgres and SpiceDB log every few minutes even when the demo is idle, the core does not): the collector is down or has no Secret, Grafana refuses its token, or the demo is down. No data counts as firing here (docs/dev/demo.md#telemetry)."
  },
  "labels": {
    "app": "openfief",
    "env": "demo",
    "severity": "critical"
  },
  "data": [
    {
      "refId": "A",
      "relativeTimeRange": {
        "from": 1800,
        "to": 0
      },
      "datasourceUid": "grafanacloud-logs",
      "model": {
        "refId": "A",
        "datasource": {
          "type": "loki",
          "uid": "grafanacloud-logs"
        },
        "expr": "sum(count_over_time({k8s_namespace_name=\"openfief\"}[30m])) or vector(0)",
        "editorMode": "code",
        "intervalMs": 1000,
        "maxDataPoints": 43200,
        "queryType": "instant"
      }
    },
    {
      "refId": "B",
      "datasourceUid": "__expr__",
      "model": {
        "refId": "B",
        "type": "reduce",
        "expression": "A",
        "reducer": "last",
        "datasource": {
          "type": "__expr__",
          "uid": "__expr__"
        },
        "intervalMs": 1000,
        "maxDataPoints": 43200
      }
    },
    {
      "refId": "C",
      "datasourceUid": "__expr__",
      "model": {
        "refId": "C",
        "type": "threshold",
        "expression": "B",
        "datasource": {
          "type": "__expr__",
          "uid": "__expr__"
        },
        "intervalMs": 1000,
        "maxDataPoints": 43200,
        "conditions": [
          {
            "evaluator": {
              "type": "lt",
              "params": [
                1
              ]
            },
            "operator": {
              "type": "and"
            },
            "query": {
              "params": [
                "C"
              ]
            },
            "reducer": {
              "type": "last",
              "params": []
            },
            "type": "query"
          }
        ]
      }
    }
  ]
}
